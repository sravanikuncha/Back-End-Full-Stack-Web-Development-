        "/api/otp/verify": {
            "post": {
             "tags": ["OTP"],
              "summary": "verify OTP",
              "requestBody":
              {
                  "content":
                  {
                      "application/json":{
                          "schema": {
                              "type": "object",
                              "properties": {
                                  "otp":{
                                      "type": "string"
                                  }
                              }
                          }
                      }
                  }
              },
              "responses": {
                "200": {
                    "description":"OTP verified Successfully"
                },
                "400":{
                    "description":"Invalid OTP"
                },
                "401":{
                    "description":"UnAuthorised"
                }
              },
              "security":{
                "cookieAuth":[]
            }
         }
        },
        
        
