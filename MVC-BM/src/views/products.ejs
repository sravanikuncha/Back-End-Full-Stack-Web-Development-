
        <table class="table table-dark">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Price</th>
                    <th scope="col">Image</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                <% products.forEach((eachProduct)=>{ %>
                    <tr>
                        <th><%= eachProduct.id %></th>
                        <td><%= eachProduct.name %></td>
                        <td><%= eachProduct.description %> </td>
                        <td scope="col"><%= eachProduct.price %></td>
                        <td>
                            <img src="<%= eachProduct.image %>" />
                        </td>
                        <td>
                            <a class="btn btn-primary" href="/update-product/<%= eachProduct.id %>" role="button">Edit</a>
                            <a class="btn btn-danger" href="/delete-product/<%= eachProduct.id %>" role="button">Delete</a>
                             <!-- <button class="btn btn-danger" onclick="deleteProductFromJS('<%= eachProduct.id %>')">Delete</button> -->
                        </td>
                    </tr>
                <% }) %>
                
