<form action='/fileSave' method="post" enctype="multipart/form-data">
    <div class="mb-3">
      <label for="exampleInputEmail1" class="form-label">Enterprise ID</label>
      <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp">
    </div>
    <div class="mb-3">
      <label for="role" class="form-label">Role</label>
      <input type="text" class="form-control" id="role">
    </div>
    <div class="mb-3">
        <label for="formFile" class="form-label">Upload Letter</label>
        <input class="form-control" type="file" id="formFile" name="myFile">
      </div>
    <button type="submit" class="btn btn-primary">Upload</button>
  </form>