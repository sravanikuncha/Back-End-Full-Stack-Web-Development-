<!-- Write your code here to render the search data -->

<%if(products.length>0){%>
    <div class="container p-5 gap-2 d-flex flex-wrap">
        <% products.forEach((product)=>{ %>
        <div class="card" style="width: 18rem">
        <img src="<%=product.image%>" class="card-img-top" alt="..." />
        <div class="card-body">
            <p class="card-text"><%=product.name%></p>
        </div>
        </div>
        <%})%>
    </div>
<%} else{%>
    <h2 style="color: red; text-align: center;">Oops! No products marching to your search found</h2>
<%}%>
  