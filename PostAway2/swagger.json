                        "schema":{
                            "type":"object",
                            "properties":{
                                "caption":{
                                    "type":"string"
                                },
                                "avatar":{
                                        "type": "string",
                                        "format": "binary"
                                }
                            }   
                        }
                    }
                }
             },
              "responses": {
                "201": {
                  "description": "Post Created successfully"
                },
                "401":{
                    "description": "Unauthorised"
                }
              },
              "security":{
                "cookieAuth":[]
            }
         }
        },

